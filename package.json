{
  "name": "kestrel-jet-sim",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node tools/inline.mjs",
    "preview": "vite preview",
    "top-speed": "esbuild tools/top-speed.ts --bundle --platform=node --format=esm --outfile=dist/top-speed.mjs --log-level=error && node dist/top-speed.mjs",
    "bomb-check": "esbuild tools/bomb-check.ts --bundle --platform=node --format=esm --outfile=dist/bomb-check.mjs --log-level=error && node dist/bomb-check.mjs",
    "flight-check": "esbuild tools/flight-check.ts --bundle --platform=node --format=esm --outfile=dist/flight-check.mjs --log-level=error && node dist/flight-check.mjs",
    "threat-check": "esbuild tools/threat-check.ts --bundle --platform=node --format=esm --outfile=dist/threat-check.mjs --log-level=error && node dist/threat-check.mjs"
  },
  "dependencies": {
    "three": "0.170.0"
  },
  "devDependencies": {
    "@types/three": "0.170.0",
    "typescript": "5.6.3",
    "vite": "5.4.11"
  }
}
